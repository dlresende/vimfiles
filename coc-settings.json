{
  "languageserver": {
    "golang": {
      "command": "gopls",
      "rootPatterns": [
        "go.mod",
        ".vim/",
        ".git/",
        ".hg/"
      ],
      "filetypes": [
        "go"
      ],
      "initializationOptions": {
        "usePlaceholders": true
      }
    },
    "bash": {
      "command": "bash-language-server",
      "args": [
        "start"
      ],
      "filetypes": [
        "sh",
        "bash"
      ],
      "ignoredRootPaths": [
        "~"
      ]
    },
    "ruff": {
      "command": "ruff",
      "args": [
        "server"
      ],
      "filetypes": [
        "python"
      ],
      "rootPatterns": [
        "pyproject.toml",
        "ruff.toml",
        ".ruff.toml",
        ".git/"
      ]
    }
  },
